# Copy to realtime/.env and fill in your LiveKit Cloud project's values
# (cloud.livekit.io -> project -> Settings -> API keys).
# realtime/.env is gitignored — never commit the real one.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret for the host console (start/next/extend/end a language-exchange
# session). Pick any string; hosts type it into the 🎓 panel in the browser.
# Leave empty and nobody can host.
HOST_KEY=

# Optional: chat history persistence (docker compose -f infra/docker-compose.yml up -d).
# Leave unset to run with in-memory-only chat (no history across restarts).
DATABASE_URL=postgres://engchatroom:engchatroom@localhost:5432/engchatroom?sslmode=disable
